# Example environment variables for Power Importer
# Copy this file to .env and fill in your actual values
# DO NOT commit your actual .env file to version control

# ERP API Configuration
# Required for process_japan_exports.py
ERP_CLIENT_ID=5d0ad744-0ae3-4712-b057-2cac7afb52f8
ERP_CLIENT_SECRET=your_client_secret_here
ERP_TOKEN_URL=https://login.microsoftonline.com/6b83c27c-aa6d-475a-9933-5c34bb008d73/oauth2/v2.0/token
ERP_API_URL=https://api.businesscentral.dynamics.com/v2.0/6b83c27c-aa6d-475a-9933-5c34bb008d73/Staging/ODataV4/Company('VCT')/PurchaseJournals
ERP_SCOPE=https://api.businesscentral.dynamics.com/.default

# Database Connection (if needed)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=erp_database
# DB_USER=username
# DB_PASSWORD=password

# File Paths (optional)
# DEFAULT_INPUT_DIR=/path/to/input/files
# DEFAULT_OUTPUT_DIR=/path/to/output/files

# Other Configuration
# DEBUG_MODE=False
# LOG_LEVEL=INFO
